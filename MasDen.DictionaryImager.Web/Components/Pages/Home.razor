@page "/"
@using MasDen.DictionaryImager.Web.Models
@using System.Text.Json
@using System.Text
@using System.Text.RegularExpressions

@inject Settings Settings

<PageTitle>Find image</PageTitle>

<span class="invalid" style="display:@FailedPromptMessageDisplay">Operation failed.</span>

<EditForm Model="Model" OnValidSubmit="GeneratePromptsAsync" FormName="GeneratePrompts">
    <DataAnnotationsValidator />
    <div>
        <label>
            Enter word:
            <InputText @bind-Value="Model!.Word" />
        </label>
    </div>
    <div>
        <button type="submit">Generate Prompts</button>
    </div>
</EditForm>

<EditForm Model="Model" OnValidSubmit="GenerateImageAsync" FormName="GenerateImage">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div>
        <label>
            Select prompt:
            <InputSelect @bind-Value="Model!.GenerateImagePrompt">
                @foreach (var prompt in GenerateImagePrompts)
                {
                    <option value="@prompt">@prompt</option>
                }
            </InputSelect>
        </label>
    </div>
    <div>
        <label>
            Select model:
            <InputSelect @bind-Value="Model!.GenerateImageModel">
                @foreach (var prompt in GenerateImageModels)
                {
                    <option value="@prompt">@prompt</option>
                }
            </InputSelect>
        </label>
    </div>
    <div>
        <label>
            Steps (free: 4, max: 50):
            <InputNumber @bind-Value="Model!.Steps" />
        </label>
    </div>
    <div>
        <button type="submit">Generate Image</button>
    </div>
</EditForm>

@if(!string.IsNullOrWhiteSpace(ImageDataURL))
{
    <img src="@ImageDataURL" />
}

@code {
    [SupplyParameterFromForm]
    private GenerateImageViewModel Model { get; set; } = null!;

    private List<string> GenerateImagePrompts { get; set; } = new();
    private string ImageDataURL { get; set; } = string.Empty;
    private List<string> GenerateImageModels { get; set; } = new()
    {
        "black-forest-labs/FLUX.1-schnell-Free",
        "black-forest-labs/FLUX.1-dev"
    };

    private string FailedPromptMessageDisplay { get; set; } = "none";

    private void ShowHideFailedPromptMessage(bool show) =>
        FailedPromptMessageDisplay = show ? "block" : "none";

    protected override void OnInitialized() =>
        Model ??= new();

    private async Task GeneratePromptsAsync()
    {
        HttpClient httpClient = new()
        {
            BaseAddress = Settings.TogetherAiUri
        };

        var requestBody = new CompletionsRequest();
        requestBody.Messages.Add(new CompletionsRequestMessage(
            "user",
            $"Give me the list of 10 prompts without an explanation to generate an image to the dictionary for the Dutch word '{Model?.Word}'"));

        var request = new HttpRequestMessage(HttpMethod.Post, "chat/completions")
        {
            Content = JsonContent.Create(requestBody)
        };
        request.Headers.Add("Authorization", $"Bearer {Settings.TogetherAiKey}");

        var response = await httpClient.SendAsync(request);
        var completions = await response.Content.ReadFromJsonAsync<CompletionsResponse>();

        if (
            completions is null ||
            completions?.Choices?.Count == 0 ||
            string.IsNullOrWhiteSpace(completions?.Choices?[0].Message?.Content))
        {
            ShowHideFailedPromptMessage(true);
            return;
        }

        ShowHideFailedPromptMessage(false);

        foreach (var content in completions.Choices.Select(x => x.Message.Content))
        {
            var matches = Regex.Matches(content, @"^\d+\.\s+(.*)", RegexOptions.Multiline);
            GenerateImagePrompts.AddRange(matches.Cast<Match>().Select(m => m.Groups[1].Value));
        }
    }

    private async Task GenerateImageAsync()
    {
        HttpClient httpClient = new()
        {
            BaseAddress = Settings.TogetherAiUri
        };

        var requestBody = new GenerateImageRequest(Model.GenerateImagePrompt!, Model.GenerateImageModel, Model.Steps);

        var request = new HttpRequestMessage(HttpMethod.Post, "images/generations")
        {
            Content = JsonContent.Create(requestBody)
        };

        request.Headers.Add("Authorization", $"Bearer {Settings.TogetherAiKey}");

        var response = await httpClient.SendAsync(request);

        if(!response.IsSuccessStatusCode)
        {
            ShowHideFailedPromptMessage(true);

            var statusMessage = await response.Content.ReadAsStringAsync();
        }

        var responseContent = await response.Content.ReadFromJsonAsync<GenerateImageResponse>();

        if (responseContent?.Data == null || responseContent?.Data?.Count() == 0 || string.IsNullOrWhiteSpace(responseContent?.Data[0].Image))
        {
            ShowHideFailedPromptMessage(true);
            return;
        }

        ShowHideFailedPromptMessage(false);

        var bytes = Convert.FromBase64String(responseContent?.Data[0].Image!);

        using (var bitmap = SkiaSharp.SKBitmap.Decode(bytes))
        {
            using(var scaled = bitmap.Resize(new SkiaSharp.SKImageInfo(200, 200), SkiaSharp.SKSamplingOptions.Default))
            {
                using(var image = SkiaSharp.SKImage.FromBitmap(scaled))
                {
                    using(var encodedImage = image.Encode())
                    {
                        var stream = new MemoryStream();
                        encodedImage.SaveTo(stream);
                        stream.Seek(0, SeekOrigin.Begin);

                        var base64 = Convert.ToBase64String(stream.ToArray());
                        ImageDataURL = $"data:image/jpeg;base64,{base64}";
                    }
                }
            }
        }

        //ImageDataURL = $"data:image/jpeg;base64,{responseContent?.Data[0].Image}";
    }
}